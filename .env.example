# Anbean — ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyala. Gerçek değerleri commit'leme.

# Zorunlu — PostgreSQL bağlantısı
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Zorunlu — oturum imza anahtarı (HMAC-SHA256). Üretimde rastgele 32+ bayt kullan.
SESSION_SECRET="degistir-bunu-uzun-rastgele-bir-deger"

# Opsiyonel — yalnızca yerel geliştirme için hash'li demo hesapları oluşturur.
# Açıkça true yapılmadıkça çalışmaz ve production ortamında çalıştırılamaz.
ALLOW_DEMO_SEED="false"

# Opsiyonel — Pexels medya proxy'si. Boşsa media_slots'taki sabit URL'ler kullanılır.
PEXELS_API_KEY=""

# Opsiyonel — e-posta sağlayıcısı. Boşsa şifre sıfırlama bağlantısı sunucu
# günlüğüne yazılır (arayüz bunu kullanıcıya açıkça söyler).
SMTP_URL=""
MAIL_FROM=""

# Opsiyonel — ödeme sağlayıcısı. Boşsa cüzdan yüklemesi simülasyon olarak çalışır.
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""

# Kullanılmıyor — haritalar şematik SVG. Gerçek harita için eklenir.
MAPBOX_TOKEN=""
